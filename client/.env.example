# NZ Grocery - Environment Configuration Example
# Copy this file to .env.local, .env.staging, or .env.production and update the values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3

# Application Configuration
VITE_APP_NAME=NZ Grocery
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_51SMNFzCorRhuzfGNznZ3UtNdW0PaL4IytnSHL8BDAhu5O4nONO7DKcEfll8MCJUxBixiPZOtGXcj4oTHsV53Ac4300Sooa8Cnl

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_OFFLINE_MODE=false

# Authentication
VITE_JWT_SECRET=your-jwt-secret-here
VITE_TOKEN_EXPIRATION=24

# Payment Configuration
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Analytics
VITE_GA_TRACKING_ID=your_ga_tracking_id_here
VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id_here

# Development Tools
VITE_ENABLE_REACT_DEVTOOLS=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Performance
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_IMAGE_OPTIMIZATION=true

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,ma

# Search Configuration
VITE_SEARCH_DEBOUNCE_DELAY=300
VITE_MAX_SEARCH_RESULTS=50

# Pagination
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Security
VITE_HTTPS_ONLY=false
VITE_CSP_REPORT_URI=https://your-domain.com/csp-report

# Error Reporting
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ENABLE_ERROR_REPORTING=false
